<!-- যোগাযোগ (Contact Us) পেজ -->
<section class="max-w-6xl mx-auto px-4 py-12">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-rb-50 text-rb-600 border border-rb-100 mb-3">
      <i class="fa-solid fa-headset mr-1"></i>সহায়তা ও যোগাযোগ
    </span>
    <h1 class="font-head text-3xl sm:text-4xl font-bold text-rb-900 leading-tight">
      আমাদের সাথে <span class="text-rb-600">যোগাযোগ</span> করুন
    </h1>
    <p class="text-gray-600 text-sm sm:text-base mt-2">
      রক্তবার্তা সংক্রান্ত যেকোনো জিজ্ঞাসা, প্রযুক্তিগত সহায়তা, পরামর্শ বা স্বেচ্ছাসেবী হিসেবে যুক্ত হতে বার্তা পাঠান।
    </p>
  </div>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- বামে যোগাযোগ তথ্য কার্ডসমূহ -->
    <div class="space-y-6">
      <div class="glass rounded-3xl p-6 border border-rb-50 card-hover">
        <div class="w-12 h-12 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-xl mb-4 shadow-inner">
          <i class="fa-solid fa-envelope"></i>
        </div>
        <h3 class="font-head text-base font-bold text-gray-900">ইমেইল যোগাযোগ</h3>
        <p class="text-xs text-gray-500 mt-1">যেকোনো তথ্য বা অফিশিয়াল বার্তা পাঠাতে:</p>
        <a href="mailto:support@roktobarta.com" class="text-sm font-semibold text-rb-600 hover:underline mt-2 block">
          support@roktobarta.com
        </a>
      </div>

      <div class="glass rounded-3xl p-6 border border-rb-50 card-hover">
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl mb-4 shadow-inner">
          <i class="fa-brands fa-whatsapp text-2xl"></i>
        </div>
        <h3 class="font-head text-base font-bold text-gray-900">ফোন ও হোয়াটসঅ্যাপ</h3>
        <p class="text-xs text-gray-500 mt-1">সরাসরি কল বা হোয়াটসঅ্যাপে যেকোনো প্রয়োজনে বার্তা পাঠান:</p>
        <div class="mt-3 space-y-2">
          <a href="tel:01516579760" class="flex items-center gap-2 text-sm font-bold text-gray-900 hover:text-rb-600 transition">
            <i class="fa-solid fa-phone text-xs text-rb-600"></i>
            <span>০১৫১৬৫৭৯৭৬০ (01516579760)</span>
          </a>
          <a href="https://wa.me/8801516579760" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white hover:bg-emerald-700 transition shadow-sm mt-1">
            <i class="fa-brands fa-whatsapp text-sm"></i>
            <span>হোয়াটসঅ্যাপে মেসেজ পাঠান</span>
          </a>
        </div>
      </div>

      <div class="glass rounded-3xl p-6 border border-rb-50 card-hover">
        <div class="w-12 h-12 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-xl mb-4 shadow-inner">
          <i class="fa-solid fa-location-dot"></i>
        </div>
        <h3 class="font-head text-base font-bold text-gray-900">যোগাযোগের ঠিকানা</h3>
        <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-rb-50 text-rb-700 border border-rb-200 mt-1">
          ১০০% অনলাইন ভিত্তিক প্ল্যাটফর্ম
        </span>
        <p class="text-xs text-gray-700 mt-2.5 leading-relaxed font-medium">
          বাড়ি ১২, রোড এভিনিউ-৮, ব্লক এম, বনশ্রী, ঢাকা, বাংলাদেশ।
        </p>
        <p class="text-[11px] text-gray-400 mt-1.5">
          (সকল কার্যক্রম ডিজিটাল পদ্ধতিতে অনলাইনে পরিচালিত হয়)
        </p>
      </div>

      <div class="glass rounded-3xl p-6 border border-rb-50 bg-gradient-to-br from-white to-rb-50 text-xs text-gray-600">
        <p class="font-semibold text-gray-800 mb-1"><i class="fa-solid fa-circle-info text-rb-600 mr-1"></i>জরুরি রক্তের প্রয়োজনে:</p>
        <p>ওয়েবসাইটে সরাসরি রক্তের অনুরোধ পোস্ট করুন অথবা আপনার জেলা অনুযায়ী রক্তদাতাদের খুঁজুন। এটি সবচেয়ে দ্রুততম মাধ্যম।</p>
      </div>
    </div>

    <!-- ডানে বার্তা পাঠানোর ফর্ম -->
    <div class="lg:col-span-2 glass rounded-3xl p-6 sm:p-10 border border-rb-100">
      <h2 class="font-head text-2xl font-bold text-rb-900 mb-2">আমাদের বার্তা লিখুন</h2>
      <p class="text-xs sm:text-sm text-gray-600 mb-6">আপনার মেসেজটি সরাসরি আমাদের সাপোর্ট ডেস্কে পৌঁছাবে।</p>

      <form action="/contact" method="POST" class="space-y-5">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">আপনার নাম <span class="text-rb-600">*</span></label>
            <input type="text" name="name" required placeholder="আপনার পুরো নাম লিখুন" value="<%= currentUser ? currentUser.name : '' %>" class="w-full text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">ইমেইল ঠিকানা <span class="text-rb-600">*</span></label>
            <input type="email" name="email" required placeholder="name@example.com" value="<%= currentUser ? currentUser.email : '' %>" class="w-full text-sm">
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">মোবাইল নম্বর (ঐচ্ছিক)</label>
            <input type="tel" name="phone" placeholder="০১XXXXXXXXX" value="<%= currentUser ? currentUser.phone : '' %>" class="w-full text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">বার্তার বিষয় <span class="text-rb-600">*</span></label>
            <select name="subject" required class="w-full text-sm">
              <option value="">বিষয় নির্বাচন করুন</option>
              <option value="সাধারণ অনুসন্ধান">সাধারণ অনুসন্ধান</option>
              <option value="প্রযুক্তিগত সমস্যা / রিপোর্ট">প্রযুক্তিগত সমস্যা / রিপোর্ট</option>
              <option value="রক্তদাতা তথ্য সংক্রান্ত">রক্তদাতা তথ্য সংক্রান্ত</option>
              <option value="স্বেচ্ছাসেবী হিসেবে যোগ দেওয়া">স্বেচ্ছাসেবী হিসেবে যোগ দেওয়া</option>
              <option value="অন্যান্য পরামর্শ">অন্যান্য পরামর্শ</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">বার্তা বা জিজ্ঞাসার বিস্তারিত বিবরণ <span class="text-rb-600">*</span></label>
          <textarea name="message" rows="5" required placeholder="আপনার মতামত বা সমস্যা বিস্তারিতভাবে লিখুন..." class="w-full text-sm"></textarea>
        </div>

        <button type="submit" class="btn px-8 py-3 text-sm">
          <i class="fa-solid fa-paper-plane mr-2"></i>বার্তা পাঠান
        </button>
      </form>
    </div>
  </div>
</section>
