<!-- রক্তদানের নিয়মাবলী ও স্বাস্থ্য নির্দেশিকা (Guide) পেজ -->
<section class="max-w-5xl mx-auto px-4 py-12">
  <div class="text-center max-w-2xl mx-auto mb-14">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-rb-50 text-rb-600 border border-rb-100 mb-3">
      <i class="fa-solid fa-notes-medical mr-1"></i>স্বাস্থ্যবিধি ও সচেতনতা
    </span>
    <h1 class="font-head text-3xl sm:text-4xl md:text-5xl font-bold text-rb-900 leading-tight">
      নিরাপদ <span class="text-rb-600">রক্তদানের নিয়মাবলী</span> ও প্রস্তুতি
    </h1>
    <p class="text-gray-600 text-sm sm:text-base mt-3">
      রক্তদান একটি সম্পূর্ণ নিরাপদ প্রক্রিয়া। রক্তদানের পূর্বে, চলাকালীন এবং পরবর্তী করণীয় সম্পর্কে বিস্তারিত জেনে নিন।
    </p>
  </div>

  <!-- ৩ ধাপের প্রস্তুতি কার্ডসমূহ -->
  <div class="grid md:grid-cols-3 gap-8 mb-16">
    <!-- ধাপ ১: রক্তদানের পূর্বে -->
    <div class="glass rounded-3xl p-7 border border-rb-50 card-hover flex flex-col justify-between">
      <div>
        <div class="w-14 h-14 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-2xl font-bold mb-5 shadow-inner">
          ০১
        </div>
        <h3 class="font-head text-xl font-bold text-rb-900 mb-4">রক্তদানের পূর্বে করণীয়</h3>
        <ul class="space-y-3 text-sm text-gray-700 leading-relaxed">
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>আগের রাতে কমপক্ষে ৭ থেকে ৮ ঘণ্টা পর্যাপ্ত ও নিরবচ্ছিন্ন ঘুমান।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>রক্তদানের ২-৩ ঘণ্টা পূর্বে পুষ্টিকর খাবার গ্রহণ করুন। খালি পেটে কখনোই রক্ত দেবেন না।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>রক্তদানের দিন অতিরিক্ত পানি ও ফলের রস পান করুন।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-xmark text-red-600 mt-1"></i>
            <span>রক্তদানের ২৪ ঘণ্টা পূর্বে অ্যালকোহল ও ভারী ধূমপান বর্জন করুন।</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- ধাপ ২: রক্তদানের সময় -->
    <div class="glass rounded-3xl p-7 border border-rb-50 card-hover flex flex-col justify-between">
      <div>
        <div class="w-14 h-14 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-2xl font-bold mb-5 shadow-inner">
          ০২
        </div>
        <h3 class="font-head text-xl font-bold text-rb-900 mb-4">রক্তদানের সময় করণীয়</h3>
        <ul class="space-y-3 text-sm text-gray-700 leading-relaxed">
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>রিল্যাক্স থাকুন এবং স্বাভাবিকভাবে শ্বাস-প্রশ্বাস নিন। এতে মাত্র ৮-১০ মিনিট সময় লাগে।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>সুঁই ফোটানোর আগে জীবাণুমুক্ত নতুন ডিসপোজেবল সুঁচ ব্যবহার নিশ্চিত করুন।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>যদি কোনো কারণে মাথা ঘোরা বা অস্বস্তি বোধ করেন, তখনই দায়িত্বপ্রাপ্ত মেডিকেল কর্মীকে জানান।</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- ধাপ ৩: রক্তদানের পরে -->
    <div class="glass rounded-3xl p-7 border border-rb-50 card-hover flex flex-col justify-between">
      <div>
        <div class="w-14 h-14 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-2xl font-bold mb-5 shadow-inner">
          ০৩
        </div>
        <h3 class="font-head text-xl font-bold text-rb-900 mb-4">রক্তদানের পর যত্ন</h3>
        <ul class="space-y-3 text-sm text-gray-700 leading-relaxed">
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>রক্তদান শেষে বেডে অন্তত ১০ থেকে ১৫ মিনিট শুয়ে বা বসে বিশ্রাম নিন।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>হালকা জলখাবার ও তরল পানীয় (জুস বা পানি) পান করুন।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-xmark text-red-600 mt-1"></i>
            <span>পরবর্তী ৫-৬ ঘণ্টার মধ্যে ভারী ব্যায়াম বা ওজন উত্তোলন থেকে বিরত থাকুন।</span>
          </li>
          <li class="flex items-start gap-2">
            <i class="fa-solid fa-check text-green-600 mt-1"></i>
            <span>সুঁইয়ের স্থানে লাগানো ব্যান্ডেজ কমপক্ষে ৪-৫ ঘণ্টা রাখুন।</span>
          </li>
        </ul>
      </div>
    </div>
  </div>

  <!-- রক্তদানের স্বাস্থ্যগত উপকারিতা -->
  <div class="glass rounded-3xl p-8 sm:p-12 mb-16 border border-rb-100">
    <h2 class="font-head text-2xl sm:text-3xl font-bold text-rb-900 mb-6 text-center">
      নিয়মিত রক্তদানের <span class="text-rb-600">স্বাস্থ্যগত উপকারিতা</span>
    </h2>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-white/70 rounded-2xl p-5 border border-rb-50 text-center">
        <i class="fa-solid fa-heart-pulse text-3xl text-rb-600 mb-3 block"></i>
        <h4 class="font-bold text-gray-900 mb-2">হৃদরোগের ঝুঁকি হ্রাস</h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          নিয়মিত রক্তদান রক্তে অতিরিক্ত ক্ষতিকারক আয়রনের মাত্রা নিয়ন্ত্রণ করে হৃদরোগ ও স্ট্রোকের ঝুঁকি কমায়।
        </p>
      </div>

      <div class="bg-white/70 rounded-2xl p-5 border border-rb-50 text-center">
        <i class="fa-solid fa-dna text-3xl text-rb-600 mb-3 block"></i>
        <h4 class="font-bold text-gray-900 mb-2">নতুন রক্তকণিকা সৃষ্টি</h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          রক্তদানের পরপরই অস্থিমজ্জা (Bone Marrow) উদ্দীপ্ত হয় এবং দ্রুত নতুন লোহিত ও শ্বেত রক্তকণিকা তৈরি করে।
        </p>
      </div>

      <div class="bg-white/70 rounded-2xl p-5 border border-rb-50 text-center">
        <i class="fa-solid fa-stethoscope text-3xl text-rb-600 mb-3 block"></i>
        <h4 class="font-bold text-gray-900 mb-2">বিনা খরচে স্বাস্থ্য পরীক্ষা</h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          প্রতিবার রক্তদানের পূর্বে ওজন, রক্তচাপ, হিমোগ্লোবিন এবং রক্তবাহিত ৫টি রোগের সম্পূর্ণ স্ক্রিনিং হয়।
        </p>
      </div>

      <div class="bg-white/70 rounded-2xl p-5 border border-rb-50 text-center">
        <i class="fa-solid fa-face-smile text-3xl text-rb-600 mb-3 block"></i>
        <h4 class="font-bold text-gray-900 mb-2">মানসিক তৃপ্তি ও আনন্দ</h4>
        <p class="text-xs text-gray-600 leading-relaxed">
          এক ব্যাগ রক্ত দিয়ে একজন মুমূর্ষু মানুষের জীবন বাঁচানোর আত্মতৃপ্তি মানসিক প্রশান্তি বাড়িয়ে দীর্ঘায়ু দেয়।
        </p>
      </div>
    </div>
  </div>
</section>
