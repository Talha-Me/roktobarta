<!-- সাধারণ জিজ্ঞাসা ও উত্তর (FAQ) পেজ -->
<section class="max-w-4xl mx-auto px-4 py-12">
  <div class="text-center max-w-2xl mx-auto mb-12">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-rb-50 text-rb-600 border border-rb-100 mb-3">
      <i class="fa-solid fa-circle-question mr-1"></i>প্রয়োজনীয় প্রশ্নোত্তর
    </span>
    <h1 class="font-head text-3xl sm:text-4xl font-bold text-rb-900 leading-tight">
      সাধারণ <span class="text-rb-600">জিজ্ঞাসা ও উত্তর</span> (FAQ)
    </h1>
    <p class="text-gray-600 text-sm sm:text-base mt-2">
      রক্তদান, রক্ত গ্রহণ, নিরাপত্তা ও রক্তবার্তা ব্যবহারের নিয়মাবলী সম্পর্কিত প্রচলিত প্রশ্নের সুস্পষ্ট উত্তর।
    </p>
  </div>

  <!-- ১. রক্তদান সংক্রান্ত প্রশ্নাবলী -->
  <div class="mb-10">
    <h2 class="font-head text-xl font-bold text-rb-900 mb-4 flex items-center gap-2">
      <i class="fa-solid fa-droplet text-rb-600"></i>রক্তদান ও যোগ্যতা সম্পর্কিত
    </h2>
    <div class="space-y-4">
      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>কে কে রক্ত দিতে পারবেন?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          যেকোনো সুস্থ ব্যক্তি যার বয়স ১৮ থেকে ৬০ বছরের মধ্যে, শারীরিক ওজন কমপক্ষে ৪৫ কেজি (পুরুষদের ক্ষেত্রে желательно ৫০ কেজি) এবং রক্তে হিমোগ্লোবিনের মাত্রা স্বাভাবিক—তিনি রক্তদান করতে পারেন।
        </div>
      </details>

      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>কতদিন পর পর রক্ত দেওয়া যায়?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          চিকিৎসা বিজ্ঞান অনুযায়ী, একজন সুস্থ পুরুষ প্রতি ৩ মাস (৯০ দিন) পর পর এবং একজন সুস্থ নারী প্রতি ৪ মাস (১২০ দিন) পর পর নিরাপদে পূর্ণাঙ্গ রক্তদান করতে পারেন।
        </div>
      </details>

      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>রক্ত দিলে কি কোনো শারীরিক ক্ষতি বা দুর্বলতা হয়?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          না, রক্তদানে কোনো ক্ষতি হয় না। একজন প্রাপ্তবয়স্ক মানুষের শরীরে সাধারণত ৫ থেকে ৬ লিটার রক্ত থাকে, যার মাত্র ১ ব্যাগ (৩৫০-৪৫০ মিলি) গ্রহণ করা হয়। শরীরের তরল অংশ ২৪ থেকে ৪৮ ঘণ্টার মধ্যে পূর্ণ হয়ে যায় এবং নতুন রক্তকণিকা তৈরি হওয়া শরীরকে আরও সতেজ ও কর্মক্ষম করে।
        </div>
      </details>

      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>কারা রক্ত দিতে পারবেন না?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          যাঁদের হেপাটাইটিস বি বা সি, এইচআইভি, ম্যালেরিয়া বা সিফিলিসের মতো রক্তবাহিত রোগ রয়েছে; গর্ভবতী বা স্তন্যদায়ী মা; অ্যান্টিবায়োটিক সেবনরত ব্যক্তি এবং বিগত ৬ মাসের মধ্যে বড় ধরনের সার্জারি বা ট্যাটু করিয়েছেন এমন ব্যক্তিরা রক্তদান করতে পারবেন না।
        </div>
      </details>
    </div>
  </div>

  <!-- ২. রক্তের অনুরোধ ও গ্রহণ সংক্রান্ত -->
  <div class="mb-10">
    <h2 class="font-head text-xl font-bold text-rb-900 mb-4 flex items-center gap-2">
      <i class="fa-solid fa-hand-holding-droplet text-rb-600"></i>রক্তের অনুরোধ ও গ্রহণ সংক্রান্ত
    </h2>
    <div class="space-y-4">
      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>রক্তের অনুরোধ করতে কি টাকা লাগে?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          একদমই না! রক্তবার্তা একটি সম্পূর্ণ অলাভজনক ও উন্মুক্ত প্ল্যাটফর্ম। এখানে রক্তের অনুরোধ পোস্ট করা বা রক্তদাতার সন্ধান নেওয়া পুরোপুরি বিনামূল্যে। রক্ত কেনাবেচা আইনত দণ্ডনীয় অপরাধ।
        </div>
      </details>

      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>রক্তদাতার ফোন নম্বর কীভাবে পাব?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          রক্তদাতাদের অযাচিত ফোন বা সাইবার হয়রানি থেকে সুরক্ষিত রাখতে ফোন নম্বরটি পাবলিক ভিজিটরদের কাছে লক করা থাকে। আপনি কেবল একটি ফ্রি অ্যাকাউন্ট খুলে লগইন করলেই সরাসরি রক্তদাতার ফোন নম্বরে ক্লিক করে যোগাযোগ করতে পারবেন।
        </div>
      </details>

      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>রক্ত পাওয়ার পর আমার কী করণীয়?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          রক্ত পাওয়ার পর অনুগ্রহ করে আপনার ড্যাশবোর্ডে গিয়ে রক্তের অনুরোধটিকে ‘সংগৃহীত (Fulfilled)’ হিসেবে চিহ্নিত করুন, যাতে অন্য রক্তদাতারা অপ্রয়োজনীয়ভাবে যোগাযোগ না করেন এবং অন্যান্য জরুরি রোগীরা অগ্রাধিকার পান।
        </div>
      </details>
    </div>
  </div>

  <!-- ৩. প্ল্যাটফর্ম নিরাপত্তা ও একাউন্ট -->
  <div>
    <h2 class="font-head text-xl font-bold text-rb-900 mb-4 flex items-center gap-2">
      <i class="fa-solid fa-shield-halved text-rb-600"></i>তথ্য নিরাপত্তা ও অ্যাকাউন্ট
    </h2>
    <div class="space-y-4">
      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>আমি সাময়িকভাবে রক্তদানে অপারগ হলে কী করব?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          আপনার ড্যাশবোর্ডে গিয়ে ‘রক্তদানের জন্য প্রস্তুত’ বাটনটি অফ (Unavailable) করে রাখুন। এতে সার্চ রেজাল্টে আপনাকে সাময়িকভাবে নিষ্ক্রিয় দেখাবে এবং কেউ ফোন দিয়ে বিরক্ত করবে না। আপনি সুস্থ বা প্রস্তুত হলে পুনরায় তা অন করতে পারেন।
        </div>
      </details>

      <details class="glass rounded-2xl p-5 border border-rb-50 group transition-all duration-300 open:border-rb-200">
        <summary class="font-semibold text-gray-800 cursor-pointer list-none flex items-center justify-between text-base">
          <span>আমার ব্যক্তিগত তথ্য কি নিরাপদ?</span>
          <i class="fa-solid fa-chevron-down text-xs text-gray-400 group-open:rotate-180 transition-transform"></i>
        </summary>
        <div class="mt-3 text-sm text-gray-600 leading-relaxed border-t border-rb-50 pt-3">
          হ্যাঁ, আপনার পাসওয়ার্ড এবং স্পর্শকাতর তথ্য আন্তর্জাতিক মানের হ্যাশিং প্রক্রিয়ায় এনক্রিপ্ট করে সংরক্ষণ করা হয়। আমরা কখনো কোনো বাণিজ্যিক বা তৃতীয় পক্ষের কাছে আপনার ডেটা বিক্রি করি না।
        </div>
      </details>
    </div>
  </div>
</section>
