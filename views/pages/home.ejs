<!-- হোম পেজ অটোকমপ্লিট ও স্টোরিজ ট্যাব স্ক্রিপ্ট -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  // Autocomplete for Home Search Form
  const dInput = document.getElementById('homeDistrict');
  const uInput = document.getElementById('homeUpazila');

  if (dInput && window.initAutocomplete) {
    window.initAutocomplete(dInput, async (q) => {
      const res = await fetch(`/api/locations/districts?query=${encodeURIComponent(q)}`);
      const json = await res.json();
      return json.data || [];
    }, () => {
      if (uInput) {
        uInput.value = '';
        uInput.focus();
      }
    });
  }

  if (uInput && window.initAutocomplete) {
    window.initAutocomplete(uInput, async (q) => {
      const dist = dInput ? dInput.value.trim() : '';
      const url = `/api/locations/upazilas?district=${encodeURIComponent(dist)}&query=${encodeURIComponent(q)}`;
      const res = await fetch(url);
      const json = await res.json();
      return json.data || [];
    });
  }

  // Stories tabs filtering on Home Page
  const tabs = document.getElementById('tabs');
  if (tabs) {
    tabs.addEventListener('click', (e) => {
      const btn = e.target.closest('.tab');
      if (!btn) return;

      document.querySelectorAll('#tabs .tab').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');

      const filterRole = btn.dataset.f;
      document.querySelectorAll('.story-item').forEach(card => {
        if (filterRole === 'all' || card.dataset.role === filterRole) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
});
</script>
