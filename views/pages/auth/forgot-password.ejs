<section class="max-w-md mx-auto px-4 py-16">
  <div class="glass rounded-3xl p-6 sm:p-9 relative overflow-hidden">
    <div class="blob w-52 h-52 bg-rb-500 -top-12 -right-12"></div>

    <div class="text-center mb-8 relative z-10">
      <div class="w-16 h-16 rounded-full bg-rb-50 flex items-center justify-center text-rb-600 text-3xl mx-auto mb-3 shadow-inner">
        <i class="fa-solid fa-key"></i>
      </div>
      <h1 class="font-head text-2xl sm:text-3xl font-bold text-rb-900">
        পাসওয়ার্ড <span class="text-rb-600">ভুলে গেছেন?</span>
      </h1>
      <p class="text-sm text-gray-600 mt-2">
        আপনার নিবন্ধিত ইমেইল বা মোবাইল নম্বর দিন। আমরা আপনার ইমেইলে ৬ ডিজিটের ভেরিফিকেশন ওটিপি কোড পাঠাব।
      </p>
    </div>

    <form action="/forgot-password" method="POST" class="space-y-4 relative z-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">নিবন্ধিত ইমেইল বা মোবাইল নম্বর</label>
        <input type="text" name="email" placeholder="user@example.com বা ০১XXXXXXXXX" required autofocus>
      </div>

      <div class="pt-2">
        <button type="submit" class="btn w-full py-3.5 text-base">
          <i class="fa-solid fa-paper-plane mr-2"></i>ভেরিফিকেশন কোড পাঠান
        </button>
      </div>

      <div class="text-center text-sm text-gray-600 mt-6 pt-4 border-t border-rb-100 flex items-center justify-between">
        <a href="/reset-password" class="text-xs text-gray-500 hover:text-rb-600">ইতোমধ্যে কোড পেয়েছেন?</a>
        <a href="/login" class="text-xs text-rb-600 font-bold hover:underline">লগইনে ফিরে যান</a>
      </div>
    </form>
  </div>
</section>
