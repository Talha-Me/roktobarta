<section class="max-w-md mx-auto px-4 py-16">
  <div class="glass rounded-3xl p-6 sm:p-9 relative overflow-hidden">
    <div class="blob w-52 h-52 bg-rb-500 -top-12 -left-12"></div>

    <div class="text-center mb-8 relative z-10">
      <div class="w-16 h-16 rounded-full bg-rb-50 flex items-center justify-center text-rb-600 text-3xl mx-auto mb-3 shadow-inner">
        <i class="fa-solid fa-lock-open"></i>
      </div>
      <h1 class="font-head text-2xl sm:text-3xl font-bold text-rb-900">
        নতুন পাসওয়ার্ড <span class="text-rb-600">নির্ধারণ</span>
      </h1>
      <p class="text-sm text-gray-600 mt-2">
        <% if (token) { %>
          আপনার অ্যাকাউন্টের জন্য একটি শক্তিশালী নতুন পাসওয়ার্ড সেট করুন।
        <% } else { %>
          আপনার ইমেইলে পাঠানো ৬ ডিজিটের কোডটি ও নতুন পাসওয়ার্ড লিখুন।
        <% } %>
      </p>
    </div>

    <form action="<%= token ? '/reset-password/' + token : '/reset-password' %>" method="POST" class="space-y-4 relative z-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (token) { %>
        <input type="hidden" name="token" value="<%= token %>">
      <% } %>

      <% if (!token) { %>
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">নিবন্ধিত ইমেইল ঠিকানা <span class="text-red-600">*</span></label>
          <input type="email" name="email" value="<%= email || '' %>" placeholder="user@example.com" required <%= email ? '' : 'autofocus' %>>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">৬ ডিজিটের ভেরিফিকেশন কোড (OTP) <span class="text-red-600">*</span></label>
          <div class="relative">
            <input type="text" name="otp" placeholder="যেমন: 123456" required maxlength="8" class="text-center font-mono text-xl font-extrabold tracking-widest text-rb-700" <%= email ? 'autofocus' : '' %>>
          </div>
          <p class="text-[11px] text-gray-500 mt-1">
            <i class="fa-solid fa-envelope mr-1 text-rb-600"></i>আপনার ইনবক্স অথবা স্প্যাম ফোল্ডার চেক করুন।
          </p>
        </div>
      <% } %>

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">নতুন পাসওয়ার্ড (কমপক্ষে ৬ অক্ষর) <span class="text-red-600">*</span></label>
        <div class="password-wrap">
          <input type="password" id="newPassword" name="password" placeholder="••••••••" required minlength="6" autocomplete="new-password" <%= token ? 'autofocus' : '' %>>
          <button type="button" data-target="newPassword" class="password-toggle-btn" title="পাসওয়ার্ড দেখুন বা লুকান" aria-label="পাসওয়ার্ড দেখুন">
            <i class="fa-solid fa-eye text-sm"></i>
          </button>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">কনফার্ম নতুন পাসওয়ার্ড <span class="text-red-600">*</span></label>
        <div class="password-wrap">
          <input type="password" id="confirmNewPassword" name="confirmPassword" placeholder="••••••••" required minlength="6" autocomplete="new-password">
          <button type="button" data-target="confirmNewPassword" class="password-toggle-btn" title="পাসওয়ার্ড দেখুন বা লুকান" aria-label="পাসওয়ার্ড দেখুন">
            <i class="fa-solid fa-eye text-sm"></i>
          </button>
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="btn w-full py-3.5 text-base shadow-lg">
          <i class="fa-solid fa-check mr-2"></i>পাসওয়ার্ড পরিবর্তন সম্পন্ন করুন
        </button>
      </div>

      <div class="text-center text-sm text-gray-600 mt-6 pt-4 border-t border-rb-100 flex items-center justify-between">
        <a href="/forgot-password" class="text-xs text-gray-500 hover:text-rb-600">কোড পাননি? পুনরায় পাঠান</a>
        <a href="/login" class="text-xs text-rb-600 font-bold hover:underline">লগইনে ফিরে যান</a>
      </div>
    </form>
  </div>
</section>
