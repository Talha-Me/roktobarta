<section class="max-w-md mx-auto px-4 py-16">
  <div class="glass rounded-3xl p-6 sm:p-9 relative overflow-hidden">
    <div class="blob w-52 h-52 bg-rb-500 -top-12 -left-12"></div>

    <div class="text-center mb-8 relative z-10">
      <div class="w-16 h-16 rounded-full bg-rb-50 flex items-center justify-center text-rb-600 text-3xl mx-auto mb-3 shadow-inner">
        <i class="fa-solid fa-droplet"></i>
      </div>
      <h1 class="font-head text-3xl font-bold text-rb-900">
        স্বাগতম <span class="text-rb-600">রক্তবার্তায়</span>
      </h1>
      <p class="text-sm text-gray-600 mt-1">আপনার অ্যাকাউন্টে লগইন করুন</p>
    </div>

    <form action="/login" method="POST" class="space-y-4 relative z-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label class="block text-xs font-semibold text-gray-700 mb-1">ইমেইল বা মোবাইল নম্বর</label>
        <div class="relative">
          <input type="text" name="login" placeholder="user@example.com বা ০১XXXXXXXXX" required autofocus>
        </div>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1">
          <label class="block text-xs font-semibold text-gray-700">পাসওয়ার্ড</label>
          <a href="/forgot-password" class="text-xs text-rb-600 font-semibold hover:underline">পাসওয়ার্ড ভুলে গেছেন?</a>
        </div>
        <div class="password-wrap">
          <input type="password" id="loginPassword" name="password" placeholder="••••••••" required autocomplete="current-password">
          <button type="button" data-target="loginPassword" class="password-toggle-btn" title="পাসওয়ার্ড দেখুন বা লুকান" aria-label="পাসওয়ার্ড দেখুন">
            <i class="fa-solid fa-eye text-sm"></i>
          </button>
        </div>
      </div>

      <div class="flex items-center justify-between text-sm pt-1">
        <label class="flex items-center gap-2 cursor-pointer text-gray-700 text-xs">
          <input type="checkbox" name="rememberMe" class="w-4 h-4 text-rb-600 rounded">
          <span>আমাকে মনে রাখুন</span>
        </label>
      </div>

      <div class="pt-3">
        <button type="submit" class="btn w-full py-3.5 text-base">
          <i class="fa-solid fa-right-to-bracket mr-2"></i>লগইন করুন
        </button>
      </div>

      <div class="text-center text-sm text-gray-600 mt-6 pt-4 border-t border-rb-100">
        কোনো অ্যাকাউন্ট নেই? <a href="/register" class="text-rb-600 font-bold hover:underline">নতুন অ্যাকাউন্ট তৈরি করুন</a>
      </div>
    </form>
  </div>
</section>
