<section class="max-w-4xl mx-auto px-4 py-12">
  <div class="glass rounded-3xl p-6 sm:p-10 relative overflow-hidden">
    <div class="blob w-64 h-64 bg-rb-500 -top-16 -right-16"></div>

    <div class="text-center max-w-xl mx-auto mb-8 relative z-10">
      <span class="glass inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs text-rb-700 font-semibold mb-3">
        <span class="w-2 h-2 rounded-full bg-rb-500 ring-pulse"></span> নতুন অ্যাকাউন্ট
      </span>
      <h1 class="font-head text-3xl sm:text-4xl font-bold text-rb-900">
        রক্তবার্তায় <span class="text-rb-600">নিবন্ধন করুন</span>
      </h1>
      <p class="text-sm text-gray-600 mt-2">
        বাংলাদেশ ও কলকাতায় জরুরি প্রয়োজনে রক্ত পেতে বা রক্তদানে ভূমিকা রাখতে বিনামূল্যে যুক্ত হোন।
      </p>
    </div>

    <form action="/register" method="POST" autocomplete="off" class="space-y-6 relative z-10">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <!-- প্রাথমিক তথ্য -->
      <div>
        <h3 class="text-sm font-bold text-rb-700 uppercase tracking-wider mb-3 flex items-center gap-2">
          <i class="fa-solid fa-user text-rb-600"></i>ব্যক্তিগত তথ্য
        </h3>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">পূর্ণ নাম <span class="text-red-600">*</span></label>
            <input type="text" name="name" value="<%= formData.name || '' %>" placeholder="যেমন: তানভীর আহমেদ" required maxlength="80">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">ইমেইল ঠিকানা <span class="text-red-600">*</span></label>
            <input type="email" name="email" value="<%= formData.email || '' %>" placeholder="যেমন: user@example.com" required>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">মোবাইল নম্বর <span class="text-red-600">*</span></label>
            <input type="tel" name="phone" value="<%= formData.phone || '' %>" placeholder="০১XXXXXXXXX বা +৯১..." required>
            <small class="text-xs text-gray-500">বাংলাদেশ (+৮৮০) বা ভারত (+৯১) নম্বর গ্রহণযোগ্য</small>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">রক্তের গ্রুপ <span class="text-red-600">*</span></label>
            <select name="bloodGroup" required>
              <option value="">গ্রুপ নির্বাচন করুন</option>
              <option value="A+" <%= formData.bloodGroup === 'A+' ? 'selected' : '' %>>এ+ (A Positive)</option>
              <option value="A-" <%= formData.bloodGroup === 'A-' ? 'selected' : '' %>>এ- (A Negative)</option>
              <option value="B+" <%= formData.bloodGroup === 'B+' ? 'selected' : '' %>>বি+ (B Positive)</option>
              <option value="B-" <%= formData.bloodGroup === 'B-' ? 'selected' : '' %>>বি- (B Negative)</option>
              <option value="O+" <%= formData.bloodGroup === 'O+' ? 'selected' : '' %>>ও+ (O Positive)</option>
              <option value="O-" <%= formData.bloodGroup === 'O-' ? 'selected' : '' %>>ও- (O Negative)</option>
              <option value="AB+" <%= formData.bloodGroup === 'AB+' ? 'selected' : '' %>>এবি+ (AB Positive)</option>
              <option value="AB-" <%= formData.bloodGroup === 'AB-' ? 'selected' : '' %>>এবি- (AB Negative)</option>
            </select>
          </div>
        </div>
      </div>

      <!-- অবস্থান সংক্রান্ত তথ্য -->
      <div class="pt-2 border-t border-rb-100">
        <h3 class="text-sm font-bold text-rb-700 uppercase tracking-wider mb-3 flex items-center gap-2">
          <i class="fa-solid fa-location-dot text-rb-600"></i>অবস্থান ও ঠিকানা
        </h3>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">দেশ</label>
            <select name="country" id="countrySelect">
              <option value="বাংলাদেশ" selected>বাংলাদেশ</option>
              <option value="ভারত (কলকাতা)">ভারত (কলকাতা ও পার্শ্ববর্তী)</option>
            </select>
          </div>
          <div class="relative">
            <label class="block text-xs font-semibold text-gray-700 mb-1">জেলা <span class="text-red-600">*</span></label>
            <input type="text" id="regDistrict" name="district" value="<%= formData.district || '' %>" placeholder="বাংলা বা ইংরেজিতে লিখুন, যেমন: ঢাকা / Dhaka" autocomplete="off" required>
            <div class="ac-box"></div>
          </div>
          <div class="relative">
            <label class="block text-xs font-semibold text-gray-700 mb-1">উপজেলা / থানা <span class="text-red-600">*</span></label>
            <input type="text" id="regUpazila" name="upazila" value="<%= formData.upazila || '' %>" placeholder="বাংলা বা ইংরেজিতে লিখুন, যেমন: মিরপুর / Mirpur" autocomplete="off" required>
            <div class="ac-box"></div>
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-xs font-semibold text-gray-700 mb-1">নির্দিষ্ট এলাকা / গ্রাম / বাসা নম্বর (ঐচ্ছিক)</label>
          <input type="text" name="area" value="<%= formData.area || '' %>" placeholder="যেমন: রোড নং ৭, সেক্টর ৪">
        </div>
      </div>

      <!-- স্বাস্থ্য ও রক্তদান সংক্রান্ত তথ্য -->
      <div class="pt-2 border-t border-rb-100">
        <h3 class="text-sm font-bold text-rb-700 uppercase tracking-wider mb-3 flex items-center gap-2">
          <i class="fa-solid fa-heart-pulse text-rb-600"></i>স্বাস্থ্য ও রক্তদাতার তথ্য
        </h3>
        <div class="grid sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">লিঙ্গ</label>
            <select name="gender">
              <option value="পুরুষ" selected>পুরুষ</option>
              <option value="মহিলা">মহিলা</option>
              <option value="অন্যান্য">অন্যান্য</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">জন্ম তারিখ (রক্তদানে বয়স ১৮+ হতে হবে)</label>
            <input type="date" name="dateOfBirth" value="<%= formData.dateOfBirth || '' %>">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">ওজন (কেজি)</label>
            <input type="number" name="weight" min="40" max="150" value="<%= formData.weight || '' %>" placeholder="যেমন: ৬৫">
          </div>
        </div>

        <!-- সর্বশেষ রক্তদানের সময় -->
        <div class="mt-4 pt-3 border-t border-rb-50">
          <label class="block text-xs font-semibold text-gray-800 mb-1">
            <i class="fa-solid fa-droplet text-rb-600 mr-1"></i>সর্বশেষ কবে রক্ত দিয়েছেন? <span class="text-red-600">*</span>
          </label>
          <select name="lastDonationPeriod" id="lastDonationPeriod" required class="w-full text-xs">
            <option value="never" <%= formData.lastDonationPeriod === 'never' ? 'selected' : '' %>>কখনো রক্ত দেইনি (নতুন রক্তদাতা)</option>
            <option value="1_month" <%= formData.lastDonationPeriod === '1_month' ? 'selected' : '' %>>১ মাস আগে (৩ মাস পূর্ণ হয়নি – বর্তমানে রক্তদানে অনুপলব্ধ)</option>
            <option value="2_months" <%= formData.lastDonationPeriod === '2_months' ? 'selected' : '' %>>২ মাস আগে (৩ মাস পূর্ণ হয়নি – বর্তমানে রক্তদানে অনুপলব্ধ)</option>
            <option value="3_months" <%= formData.lastDonationPeriod === '3_months' ? 'selected' : '' %>>৩ মাস আগে (রক্তদানে প্রস্তুত)</option>
            <option value="over_3_months" <%= formData.lastDonationPeriod === 'over_3_months' || !formData.lastDonationPeriod ? 'selected' : '' %>>৩ মাসের বেশি আগে (রক্তদানে প্রস্তুত)</option>
          </select>
          <p class="text-[11px] text-gray-500 mt-1">
            <i class="fa-solid fa-circle-info text-rb-600 mr-1"></i>মেডিকেল নিয়ম অনুযায়ী রক্তদানের পর অন্তত ৩ মাস বিশ্রাম নেওয়া আবশ্যক। ৩ মাস পূর্ণ না হওয়া রক্তদাতাদের অযথা কল করা হয় না।
          </p>
        </div>
      </div>

      <!-- পাসওয়ার্ড -->
      <div class="pt-2 border-t border-rb-100">
        <h3 class="text-sm font-bold text-rb-700 uppercase tracking-wider mb-3 flex items-center gap-2">
          <i class="fa-solid fa-lock text-rb-600"></i>নিরাপত্তা
        </h3>
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">পাসওয়ার্ড (কমপক্ষে ৬ অক্ষর) <span class="text-red-600">*</span></label>
            <div class="password-wrap">
              <input type="password" id="registerPassword" name="password" placeholder="••••••••" required minlength="6" autocomplete="new-password">
              <button type="button" data-target="registerPassword" class="password-toggle-btn" title="পাসওয়ার্ড দেখুন বা লুকান" aria-label="পাসওয়ার্ড দেখুন">
                <i class="fa-solid fa-eye text-sm"></i>
              </button>
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">কনফার্ম পাসওয়ার্ড <span class="text-red-600">*</span></label>
            <div class="password-wrap">
              <input type="password" id="registerConfirmPassword" name="confirmPassword" placeholder="••••••••" required minlength="6" autocomplete="new-password">
              <button type="button" data-target="registerConfirmPassword" class="password-toggle-btn" title="পাসওয়ার্ড দেখুন বা লুকান" aria-label="পাসওয়ার্ড দেখুন">
                <i class="fa-solid fa-eye text-sm"></i>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- চেকস ও সম্মতি -->
      <div class="space-y-2 pt-2">
        <label class="flex items-start gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" name="isDonor" checked class="mt-1 w-4 h-4 text-rb-600 rounded">
          <span><strong>আমি একজন রক্তদাতা হতে চাই:</strong> জরুরি প্রয়োজনে রক্তের অনুরোধ আসলে আমার প্রোফাইল রক্তদাতা তালিকায় প্রদর্শিত হবে।</span>
        </label>
        <label class="flex items-start gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" name="showPhonePublic" class="mt-1 w-4 h-4 text-rb-600 rounded">
          <span>আমার ফোন নম্বর প্ল্যাটফর্মের যেকোনো লগইন করা রক্তপ্রত্যাশীর কাছে দৃশ্যমান করার অনুমতি দিচ্ছি।</span>
        </label>
        <label class="flex items-start gap-2 text-sm text-gray-700 cursor-pointer">
          <input type="checkbox" name="terms" required class="mt-1 w-4 h-4 text-rb-600 rounded">
          <span>আমি রক্তবার্তা প্ল্যাটফর্মের <a href="/terms" target="_blank" class="text-rb-600 underline font-semibold">ব্যবহারের শর্তাবলী</a> এবং <a href="/privacy-policy" target="_blank" class="text-rb-600 underline font-semibold">গোপনীয়তা নীতি</a> মেনে নিচ্ছি। <span class="text-red-600">*</span></span>
        </label>
      </div>

      <div class="pt-4">
        <button type="submit" class="btn w-full py-3.5 text-lg">
          <i class="fa-solid fa-user-plus mr-2"></i>অ্যাকাউন্ট তৈরি করুন
        </button>
      </div>

      <div class="text-center text-sm text-gray-600 mt-4">
        ইতিমধ্যে অ্যাকাউন্ট আছে? <a href="/login" class="text-rb-600 font-bold hover:underline">এখানে লগইন করুন</a>
      </div>
    </form>
  </div>
</section>

<!-- অটোকমপ্লিট ইনিশিয়ালাইজেশন স্ক্রিপ্ট -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const dInput = document.getElementById('regDistrict');
  const uInput = document.getElementById('regUpazila');

  if (dInput && window.initAutocomplete) {
    window.initAutocomplete(dInput, async (q) => {
      const res = await fetch(`/api/locations/districts?query=${encodeURIComponent(q)}`);
      const json = await res.json();
      return json.data || [];
    }, () => {
      if (uInput) {
        uInput.value = '';
        uInput.focus();
      }
    });
  }

  if (uInput && window.initAutocomplete) {
    window.initAutocomplete(uInput, async (q) => {
      const dist = dInput ? dInput.value.trim() : '';
      const url = `/api/locations/upazilas?district=${encodeURIComponent(dist)}&query=${encodeURIComponent(q)}`;
      const res = await fetch(url);
      const json = await res.json();
      return json.data || [];
    });
  }
});
</script>
