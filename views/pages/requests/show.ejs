<section class="max-w-5xl mx-auto px-4 py-10">
  <!-- ব্যাক বাটন -->
  <div class="mb-6">
    <a href="/requests" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-600 hover:text-rb-600 transition">
      <i class="fa-solid fa-arrow-left"></i> সকল রক্তের অনুরোধে ফিরে যান
    </a>
  </div>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- বাম ও মধ্য কলাম: মূল বিস্তারিত -->
    <div class="lg:col-span-2 space-y-6">
      <div class="glass rounded-3xl p-6 sm:p-8 relative overflow-hidden">
        <div class="blob w-64 h-64 bg-rb-500 -top-16 -right-16"></div>

        <!-- স্ট্যাটাস ও জরুরিতা ব্যানার -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 relative z-10">
          <div class="flex items-center gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold <%= request.status === 'open' ? 'bg-amber-100 text-amber-800' : (request.status === 'fulfilled' ? 'bg-emerald-100 text-emerald-800' : 'bg-gray-100 text-gray-700') %>">
              <%= request.status === 'open' ? 'প্রয়োজন চলছে (Open)' : (request.status === 'fulfilled' ? 'রক্ত পাওয়া গেছে (Fulfilled)' : 'অনুরোধটি বন্ধ') %>
            </span>
            <span class="text-xs text-gray-500"><i class="fa-regular fa-eye mr-1"></i><%= toBn(request.views || 1) %> বার দেখা হয়েছে</span>
          </div>

          <div class="flex items-center gap-2">
            <% if (request.urgency === 'অতি জরুরি') { %>
              <span class="bg-red-600 text-white text-xs font-bold px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-white ring-pulse"></span> অতি জরুরি
              </span>
            <% } else { %>
              <span class="glass px-3 py-1 rounded-full text-xs font-bold text-gray-700">
                <%= request.urgency %>
              </span>
            <% } %>
          </div>
        </div>

        <!-- রোগীর মূল তথ্য ও রক্তের গ্রুপ -->
        <div class="flex items-start gap-5 relative z-10 mb-8">
          <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gradient-to-br from-rb-500 to-rb-700 text-white flex flex-col items-center justify-center font-bold shadow-xl shrink-0">
            <span class="text-3xl sm:text-4xl leading-none"><%= toBnGroup(request.bloodGroup) %></span>
            <span class="text-xs opacity-90 mt-1"><%= toBn(request.bagsNeeded) %> ব্যাগ</span>
          </div>

          <div class="min-w-0">
            <h1 class="font-head text-2xl sm:text-3xl font-bold text-rb-900 leading-tight">
              <%= request.patientName %>
            </h1>
            <p class="text-sm font-semibold text-rb-600 mt-1 flex items-center gap-1.5">
              <i class="fa-solid fa-notes-medical"></i>
              রোগের ধরন: <%= request.reason %>
            </p>
            <p class="text-xs text-gray-500 mt-1.5 flex items-center gap-2">
              <span>পোস্ট করেছেন: <strong><%= request.requester ? request.requester.name : 'অজ্ঞাত' %></strong></span>
              <span>·</span>
              <span><%= timeAgoBn(request.createdAt) %></span>
            </p>
          </div>
        </div>

        <!-- বিস্তারিত তথ্য তালিকা -->
        <div class="space-y-4 pt-6 border-t border-rb-100 relative z-10 text-sm">
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="bg-white/60 p-4 rounded-2xl border border-rb-50">
              <p class="text-xs text-gray-500 mb-1">হাসপাতাল / ক্লিনিক</p>
              <p class="font-bold text-gray-800 text-base flex items-center gap-2">
                <i class="fa-solid fa-hospital text-rb-600"></i>
                <%= request.hospitalName %>
              </p>
            </div>
            <div class="bg-white/60 p-4 rounded-2xl border border-rb-50">
              <p class="text-xs text-gray-500 mb-1">অবস্থান / এলাকা</p>
              <p class="font-bold text-gray-800 text-base flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-rb-600"></i>
                <%= request.upazila %>, <%= request.district %>
              </p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="bg-white/60 p-4 rounded-2xl border border-rb-50">
              <p class="text-xs text-gray-500 mb-1">রক্ত কখন প্রয়োজন?</p>
              <p class="font-bold text-gray-800 text-base flex items-center gap-2">
                <i class="fa-regular fa-calendar-check text-rb-600"></i>
                <%= formatBnDate(request.neededDate) %>
                <% if (request.neededTime) { %>
                  (<%= request.neededTime %>)
                <% } %>
              </p>
            </div>
            <div class="bg-white/60 p-4 rounded-2xl border border-rb-50">
              <p class="text-xs text-gray-500 mb-1">ঠিকানা / ওয়ার্ড নম্বর</p>
              <p class="font-semibold text-gray-800 text-sm flex items-center gap-2">
                <i class="fa-solid fa-map-pin text-rb-600"></i>
                <%= request.address %>
              </p>
            </div>
          </div>

          <% if (request.note) { %>
            <div class="bg-rb-50/60 p-4 rounded-2xl border border-rb-100 mt-2">
              <p class="text-xs font-bold text-rb-700 mb-1 flex items-center gap-1.5">
                <i class="fa-solid fa-message"></i>বিশেষ বার্তা:
              </p>
              <p class="text-gray-700 leading-relaxed text-sm"><%= request.note %></p>
            </div>
          <% } %>
        </div>

        <!-- অনুরোধকারী বা অ্যাডমিন অ্যাকশন কন্ট্রোল -->
        <% if (isOwner || (currentUser && currentUser.role === 'admin')) { %>
          <div class="mt-8 pt-6 border-t border-rb-100 flex flex-wrap items-center justify-between gap-4 bg-white/70 p-4 rounded-2xl">
            <div>
              <p class="text-xs font-bold text-gray-700">স্ট্যাটাস পরিবর্তন করুন:</p>
              <p class="text-xs text-gray-500">রক্ত পেয়ে থাকলে অনুরোধটি সম্পন্ন করুন</p>
            </div>
            <form action="/requests/<%= request._id %>/status" method="POST" class="flex gap-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (request.status === 'open') { %>
                <button type="submit" name="status" value="fulfilled" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-full text-xs font-bold transition">
                  <i class="fa-solid fa-check mr-1"></i>রক্ত পেয়েছি
                </button>
                <button type="submit" name="status" value="closed" class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-full text-xs font-bold transition">
                  বন্ধ করুন
                </button>
              <% } else { %>
                <button type="submit" name="status" value="open" class="btn px-4 py-2 text-xs">
                  পুনরায় চালু করুন
                </button>
              <% } %>
            </form>
          </div>
        <% } %>
      </div>

      <!-- সাড়া প্রদানকারীদের তালিকা (যদি থাকে) -->
      <% if (request.responses && request.responses.length > 0) { %>
        <div class="glass rounded-3xl p-6">
          <h3 class="font-head text-lg font-bold text-rb-900 mb-4 flex items-center gap-2">
            <i class="fa-solid fa-hand-holding-heart text-rb-600"></i>
            রক্তদানে এগিয়ে এসেছেন (<%= toBn(request.responses.length) %> জন)
          </h3>
          <div class="space-y-3">
            <% request.responses.forEach(function(resp) { %>
              <div class="glass-card rounded-2xl p-4 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-rb-50 text-rb-600 flex items-center justify-center font-bold text-sm shrink-0 border border-rb-200">
                    <i class="fa-solid fa-hand-holding-droplet"></i>
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-gray-800">
                      <%= resp.donor ? resp.donor.name : 'রক্তদাতা' %>
                      <% if (resp.donor && resp.donor.bloodGroup) { %>
                        <span class="text-xs text-rb-600 font-bold ml-1">(<%= toBnGroup(resp.donor.bloodGroup) %>)</span>
                      <% } %>
                    </h4>
                    <p class="text-xs text-gray-500"><%= resp.message %></p>
                  </div>
                </div>
                <span class="text-xs text-gray-400 shrink-0"><%= timeAgoBn(resp.respondedAt) %></span>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- ডান কলাম: যোগাযোগ ও রক্তদানের সাড়া -->
    <div class="space-y-6">
      <!-- যোগাযোগের কার্ড -->
      <div class="glass rounded-3xl p-6 relative overflow-hidden border-2 border-rb-100 shadow-xl">
        <h3 class="font-head text-lg font-bold text-rb-900 mb-4 flex items-center gap-2">
          <i class="fa-solid fa-address-book text-rb-600"></i>যোগাযোগের তথ্য
        </h3>

        <div class="mb-4">
          <p class="text-xs text-gray-500">যোগাযোগকারী ব্যক্তি</p>
          <p class="font-bold text-gray-800 text-base"><%= request.contactName %></p>
        </div>

        <% if (currentUser) { %>
          <!-- লগইন করা থাকলে ফোন নম্বর সরাসরি দৃশ্যমান -->
          <div class="bg-rb-50 p-4 rounded-2xl border border-rb-200 mb-5">
            <p class="text-xs text-rb-700 font-semibold mb-1">জরুরি মোবাইল নম্বর:</p>
            <p class="text-2xl font-bold font-mono text-rb-700 tracking-wide mb-3"><%= request.contactPhone %></p>
            <div class="flex flex-col gap-2">
              <a href="tel:<%= request.contactPhone %>" class="btn py-2.5 text-sm w-full">
                <i class="fa-solid fa-phone mr-2"></i>সরাসরি কল করুন
              </a>
              <a href="https://wa.me/<%= request.contactPhone.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener noreferrer" class="px-4 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition flex items-center justify-center gap-2">
                <i class="fa-brands fa-whatsapp text-lg"></i>হোয়াটসঅ্যাপে জানান
              </a>
            </div>
          </div>
        <% } else { %>
          <!-- গেস্ট ব্যবহারকারীর জন্য ফোন নম্বর সুরক্ষিত -->
          <div class="bg-gray-100/80 p-5 rounded-2xl text-center border border-gray-200 mb-5">
            <i class="fa-solid fa-lock text-gray-400 text-3xl mb-2"></i>
            <p class="text-xs font-semibold text-gray-700 mb-3">
              নিরাপত্তার স্বার্থে রোগীর স্বজনের ফোন নম্বর কেবল নিবন্ধিত ব্যবহারকারীদের দেখানো হয়।
            </p>
            <a href="/login" class="btn px-5 py-2.5 text-xs w-full">
              <i class="fa-solid fa-right-to-bracket mr-1.5"></i>নম্বর দেখতে লগইন করুন
            </a>
          </div>
        <% } %>

        <!-- "আমি রক্ত দিতে পারি" সাড়া বোতাম -->
        <% if (request.status === 'open') { %>
          <% if (currentUser) { %>
            <% if (hasResponded) { %>
              <div class="p-3 bg-emerald-50 text-emerald-800 rounded-xl text-center text-xs font-bold border border-emerald-200">
                <i class="fa-solid fa-circle-check mr-1"></i>আপনি ইতিমধ্যে রক্তদানে সম্মতি জানিয়েছেন!
              </div>
            <% } else if (!isOwner) { %>
              <button type="button" onclick="document.getElementById('respondModal').classList.remove('hidden')" class="btn-ghost w-full py-3 text-sm font-bold mt-2">
                <i class="fa-solid fa-hand-holding-droplet mr-2 text-rb-600"></i>আমি রক্ত দিতে পারি
              </button>
            <% } %>
          <% } else { %>
            <a href="/login" class="btn-ghost w-full py-3 text-sm text-center font-bold block mt-2">
              <i class="fa-solid fa-hand-holding-droplet mr-2"></i>রক্ত দিতে লগইন করুন
            </a>
          <% } %>
        <% } %>

        <!-- সোশ্যাল শেয়ার -->
        <div class="mt-6 pt-5 border-t border-rb-100 text-center">
          <p class="text-xs text-gray-500 mb-3">একটি শেয়ার হয়তো রোগীর প্রাণ বাঁচাতে পারে:</p>
          <div class="flex justify-center gap-2.5">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(siteUrl + currentPath) %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center hover:opacity-90 transition" title="ফেসবুকে শেয়ার করুন">
              <i class="fa-brands fa-facebook-f text-sm"></i>
            </a>
            <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent('জরুরি রক্তের প্রয়োজন: ' + request.patientName + '-এর জন্য ' + toBnGroup(request.bloodGroup) + ' রক্ত লাগবে (' + request.hospitalName + ', ' + request.district + ')। বিস্তারিত: ' + siteUrl + currentPath) %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-emerald-500 text-white flex items-center justify-center hover:opacity-90 transition" title="হোয়াটসঅ্যাপে পাঠান">
              <i class="fa-brands fa-whatsapp text-sm"></i>
            </a>
            <button type="button" onclick="copyCurrentUrl()" class="w-9 h-9 rounded-full bg-gray-200 text-gray-700 flex items-center justify-center hover:bg-gray-300 transition" title="লিংক কপি করুন">
              <i class="fa-solid fa-link text-sm"></i>
            </button>
          </div>
          <span id="copyAlert" class="text-[11px] text-emerald-600 font-semibold hidden mt-2 block">লিংক কপি করা হয়েছে!</span>
        </div>
      </div>

      <!-- একই জেলার অন্যান্য জরুরি অনুরোধ -->
      <% if (relatedRequests && relatedRequests.length > 0) { %>
        <div class="glass rounded-3xl p-5">
          <h4 class="font-head text-base font-bold text-rb-900 mb-3">কাছাকাছি অন্যান্য অনুরোধ</h4>
          <div class="space-y-3">
            <% relatedRequests.forEach(function(rel) { %>
              <a href="/requests/<%= rel._id %>" class="block p-3 rounded-2xl bg-white/60 hover:bg-white transition border border-rb-50">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-bold text-rb-600"><%= toBnGroup(rel.bloodGroup) %> রক্ত প্রয়োজন</span>
                  <span class="text-[10px] text-gray-400"><%= rel.district %></span>
                </div>
                <p class="text-xs font-semibold text-gray-800 truncate"><%= rel.hospitalName %></p>
              </a>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- "আমি রক্ত দিতে পারি" মোডাল -->
<% if (currentUser && !hasResponded && !isOwner) { %>
  <div id="respondModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="glass bg-white/95 rounded-3xl p-6 sm:p-8 max-w-md w-full relative">
      <button type="button" onclick="document.getElementById('respondModal').classList.add('hidden')" class="absolute right-5 top-5 text-gray-400 hover:text-gray-700">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>

      <div class="text-center mb-4">
        <div class="w-14 h-14 rounded-full bg-rb-50 flex items-center justify-center text-rb-600 text-2xl mx-auto mb-2">
          <i class="fa-solid fa-hand-holding-heart"></i>
        </div>
        <h3 class="font-head text-xl font-bold text-rb-900">রক্তদানে সম্মতি প্রদান</h3>
        <p class="text-xs text-gray-500 mt-1">রোগীর স্বজনদের একটি আশ্বস্তকারী বার্তা দিন।</p>
      </div>

      <form action="/requests/<%= request._id %>/respond" method="POST" class="space-y-4">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">বার্তা (ঐচ্ছিক)</label>
          <textarea name="message" rows="3" placeholder="যেমন: আমি এই গ্রুপের রক্ত দিতে প্রস্তুত, যেকোনো সময় যোগাযোগ করতে পারেন..." class="text-sm">আমি রক্তদানে আগ্রহী এবং সাহায্য করতে চাই।</textarea>
        </div>

        <p class="text-xs text-gray-500">
          <i class="fa-solid fa-circle-info text-rb-600 mr-1"></i>
          আপনার প্রোফাইলের নাম ও ফোন নম্বর (<%= currentUser.phone %>) রোগীর স্বজনদের কাছে প্রেরণ করা হবে।
        </p>

        <button type="submit" class="btn w-full py-3 text-sm">
          <i class="fa-solid fa-paper-plane mr-1.5"></i>সম্মতি পাঠান
        </button>
      </form>
    </div>
  </div>
<% } %>

<script>
function copyCurrentUrl() {
  navigator.clipboard.writeText(window.location.href).then(() => {
    const alert = document.getElementById('copyAlert');
    if (alert) {
      alert.classList.remove('hidden');
      setTimeout(() => alert.classList.add('hidden'), 3000);
    }
  });
}
</script>
