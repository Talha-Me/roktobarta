<!-- ব্লগ আর্কাইভ হিরো সেকশন -->
<section class="max-w-7xl mx-auto px-4 pt-8 pb-10">
  <div class="text-center max-w-2xl mx-auto mb-10">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-rb-50 text-rb-600 border border-rb-100 mb-3">
      <i class="fa-solid fa-book-medical mr-1"></i>রক্তবার্তা ব্লগ ও স্বাস্থ্য নির্দেশিকা
    </span>
    <h1 class="font-head text-3xl sm:text-4xl font-bold text-rb-900 leading-tight">
      সুস্থ থাকুন, <span class="text-rb-600">জীবন বাঁচান</span> ও জানুন
    </h1>
    <p class="text-gray-600 text-sm sm:text-base mt-2">
      রক্তদান, পুষ্টি, চিকিৎসা সচেতনতা এবং সুস্থ জীবনযাপনের জন্য নিয়মিত বিশেষজ্ঞ পরামর্শ ও তথ্যবহুল নিবন্ধ।
    </p>

    <!-- সার্চ বার -->
    <form action="/blog" method="GET" class="mt-6 flex items-center max-w-md mx-auto glass rounded-2xl p-1.5 border border-rb-100">
      <div class="flex-1 flex items-center px-3">
        <i class="fa-solid fa-magnifying-glass text-gray-400 mr-2 text-sm"></i>
        <input type="text" name="q" value="<%= searchQuery %>" placeholder="বিষয় বা ট্যাগ লিখে খুঁজুন..." class="w-full bg-transparent border-none text-sm focus:outline-none focus:ring-0 p-1 text-gray-800">
      </div>
      <% if (selectedCategory) { %>
        <input type="hidden" name="category" value="<%= selectedCategory %>">
      <% } %>
      <button type="submit" class="btn px-4 py-2 text-sm rounded-xl">
        খুঁজুন
      </button>
    </form>
  </div>

  <!-- ক্যাটাগরি ফিল্টার পিলস -->
  <div class="flex flex-wrap items-center justify-center gap-2 mb-10">
    <a href="/blog" class="px-4 py-2 rounded-xl text-sm font-semibold transition <%= !selectedCategory ? 'bg-rb-600 text-white shadow-md shadow-rb-600/20' : 'glass hover:bg-rb-50 text-gray-700' %>">
      সকল নিবন্ধ
    </a>
    <% const categories = ['স্বাস্থ্য টিপস', 'সচেতনতা', 'রক্তদান সহায়িকা', 'বিজ্ঞান ও গবেষণা', 'অনুপ্রেরণা']; %>
    <% categories.forEach(cat => { %>
      <a href="/blog?category=<%= encodeURIComponent(cat) %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" 
         class="px-4 py-2 rounded-xl text-sm font-semibold transition <%= selectedCategory === cat ? 'bg-rb-600 text-white shadow-md shadow-rb-600/20' : 'glass hover:bg-rb-50 text-gray-700' %>">
        <%= cat %>
      </a>
    <% }) %>
  </div>

  <div class="grid lg:grid-cols-3 gap-8">
    <!-- বামে মূল পোস্ট গ্রিড (২ কলাম ডেস্কটপে) -->
    <div class="lg:col-span-2">
      <% if (posts && posts.length > 0) { %>
        <div class="grid sm:grid-cols-2 gap-6">
          <% posts.forEach(post => { %>
            <article class="glass rounded-3xl overflow-hidden card-hover flex flex-col h-full border border-rb-50">
              <!-- কভার ইমেজ -->
              <a href="/blog/<%= post.slug %>" class="relative block h-48 overflow-hidden bg-rb-50">
                <% if (post.coverImage) { %>
                  <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" onerror="this.src='/images/blog1.jpg'">
                <% } else { %>
                  <div class="w-full h-full bg-gradient-to-br from-rb-50 to-rb-100 flex items-center justify-center text-rb-300">
                    <i class="fa-solid fa-newspaper text-5xl"></i>
                  </div>
                <% } %>
                <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-rb-600 text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                  <%= post.category %>
                </span>
              </a>

              <!-- পোস্ট কন্টেন্ট -->
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-3 text-xs text-gray-500 mb-2">
                    <span><i class="fa-regular fa-clock mr-1"></i><%= post.readTime %></span>
                    <span>•</span>
                    <span><i class="fa-regular fa-calendar mr-1"></i><%= formatBnDate(post.createdAt) %></span>
                  </div>

                  <h2 class="font-head text-lg font-bold text-gray-900 leading-snug line-clamp-2 hover:text-rb-600 transition">
                    <a href="/blog/<%= post.slug %>"><%= post.title %></a>
                  </h2>

                  <p class="text-sm text-gray-600 mt-2 line-clamp-2 leading-relaxed">
                    <%= post.excerpt %>
                  </p>
                </div>

                <div class="pt-4 mt-4 border-t border-rb-50 flex items-center justify-between text-xs">
                  <div class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-full bg-rb-100 text-rb-600 flex items-center justify-center font-bold text-[10px]">
                      <i class="fa-solid fa-user-pen"></i>
                    </span>
                    <span class="font-medium text-gray-700"><%= post.authorName || 'রক্তবার্তা টিম' %></span>
                  </div>
                  <a href="/blog/<%= post.slug %>" class="text-rb-600 font-bold hover:underline flex items-center gap-1">
                    সম্পূর্ণ পড়ুন <i class="fa-solid fa-arrow-right text-[10px]"></i>
                  </a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>

        <!-- পেজিনেশন -->
        <% if (totalPages > 1) { %>
          <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 mt-12">
            <% if (hasPrevPage) { %>
              <a href="/blog?page=<%= prevPage %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="glass px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold hover:border-rb-500 transition">
                <i class="fa-solid fa-chevron-left mr-1"></i>পূর্ববর্তী
              </a>
            <% } %>

            <% const pageItems = getPagination(currentPage, totalPages); %>
            <% pageItems.forEach(function(p) { %>
              <% if (p === '...') { %>
                <span class="w-8 h-8 sm:w-10 sm:h-10 flex items-center justify-center text-xs sm:text-sm font-bold text-gray-400 select-none">...</span>
              <% } else { %>
                <a href="/blog?page=<%= p %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center text-xs sm:text-sm font-bold transition <%= p === currentPage ? 'bg-rb-600 text-white shadow-md' : 'glass hover:bg-rb-50 text-gray-700' %>">
                  <%= toBn(p) %>
                </a>
              <% } %>
            <% }) %>

            <% if (hasNextPage) { %>
              <a href="/blog?page=<%= nextPage %><%= selectedCategory ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= searchQuery ? '&q=' + encodeURIComponent(searchQuery) : '' %>" class="glass px-3.5 sm:px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold hover:border-rb-500 transition">
                পরবর্তী<i class="fa-solid fa-chevron-right ml-1"></i>
              </a>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <!-- কোনো পোস্ট না থাকলে -->
        <div class="glass rounded-3xl p-12 text-center border border-rb-100">
          <div class="w-16 h-16 rounded-full bg-rb-50 text-rb-600 flex items-center justify-center text-2xl mx-auto mb-4">
            <i class="fa-solid fa-newspaper"></i>
          </div>
          <h3 class="font-head text-xl font-bold text-gray-800">কোনো নিবন্ধ খুঁজে পাওয়া যায়নি</h3>
          <p class="text-sm text-gray-600 mt-1">অন্য কোনো কিওয়ার্ড বা ক্যাটাগরি নির্বাচন করে চেষ্টা করুন।</p>
          <a href="/blog" class="btn mt-5 inline-flex items-center px-5 py-2.5 text-sm">
            সকল নিবন্ধ দেখুন
          </a>
        </div>
      <% } %>
    </div>

    <!-- ডানে সাইডবার (জনপ্রিয় নিবন্ধ ও সহায়তা) -->
    <div class="space-y-6">
      <!-- জনপ্রিয় নিবন্ধ -->
      <% if (popularPosts && popularPosts.length > 0) { %>
        <div class="glass rounded-3xl p-6 border border-rb-50">
          <h3 class="font-head text-lg font-bold text-rb-900 mb-4 pb-2 border-b border-rb-100 flex items-center gap-2">
            <i class="fa-solid fa-fire text-rb-600"></i>জনপ্রিয় নিবন্ধসমূহ
          </h3>
          <div class="space-y-4">
            <% popularPosts.forEach(pop => { %>
              <a href="/blog/<%= pop.slug %>" class="flex gap-3 group items-center">
                <div class="w-16 h-16 rounded-xl overflow-hidden bg-rb-50 flex-shrink-0">
                  <% if (pop.coverImage) { %>
                    <img src="<%= pop.coverImage %>" alt="<%= pop.title %>" class="w-full h-full object-cover group-hover:scale-105 transition" onerror="this.src='/images/blog1.jpg'">
                  <% } else { %>
                    <div class="w-full h-full flex items-center justify-center text-rb-300">
                      <i class="fa-solid fa-file-lines"></i>
                    </div>
                  <% } %>
                </div>
                <div class="flex-1 min-w-0">
                  <h4 class="text-sm font-semibold text-gray-800 group-hover:text-rb-600 transition line-clamp-2 leading-snug">
                    <%= pop.title %>
                  </h4>
                  <span class="text-xs text-gray-400 mt-1 block">
                    <i class="fa-regular fa-calendar mr-1"></i><%= formatBnDate(pop.createdAt) %>
                  </span>
                </div>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- ক্যাটাগরি কাউন্টার -->
      <% if (categoriesCount && categoriesCount.length > 0) { %>
        <div class="glass rounded-3xl p-6 border border-rb-50">
          <h3 class="font-head text-lg font-bold text-rb-900 mb-4 pb-2 border-b border-rb-100 flex items-center gap-2">
            <i class="fa-solid fa-layer-group text-rb-600"></i>ক্যাটাগরি তালিকা
          </h3>
          <div class="space-y-2">
            <% categoriesCount.forEach(cat => { %>
              <a href="/blog?category=<%= encodeURIComponent(cat._id) %>" class="flex items-center justify-between px-3 py-2 rounded-xl text-sm font-medium hover:bg-rb-50 text-gray-700 hover:text-rb-600 transition">
                <span><%= cat._id %></span>
                <span class="text-xs bg-rb-50 text-rb-600 px-2 py-0.5 rounded-full font-bold">
                  <%= toBn(cat.count) %>
                </span>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

      <!-- রক্তদানের কল টু অ্যাকশন বক্স -->
      <div class="glass rounded-3xl p-6 border border-rb-100 bg-gradient-to-br from-white to-rb-50 text-center">
        <div class="w-12 h-12 rounded-full bg-rb-600 text-white flex items-center justify-center text-xl mx-auto mb-3 shadow-md shadow-rb-600/20">
          <i class="fa-solid fa-heart-pulse"></i>
        </div>
        <h4 class="font-head text-base font-bold text-rb-900">রক্ত দিয়ে জীবন বাঁচান</h4>
        <p class="text-xs text-gray-600 mt-1">
          আপনার রক্তে হয়তো বেঁচে যেতে পারে একজন মুমূর্ষু রোগী। আজই রক্তদাতা হিসেবে নিবন্ধন করুন।
        </p>
        <a href="/register" class="btn w-full mt-4 py-2.5 text-xs block text-center">
          রক্তদাতা হিসেবে যুক্ত হন
        </a>
      </div>
    </div>
  </div>
</section>
