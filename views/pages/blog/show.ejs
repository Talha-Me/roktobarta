<!-- ব্লগ একক পোস্ট সেকশন -->
<article class="max-w-4xl mx-auto px-4 py-8">
  <!-- ব্রেডক্রাম্ব -->
  <nav class="flex items-center gap-2 text-xs text-gray-500 mb-6 flex-wrap">
    <a href="/" class="hover:text-rb-600 transition">হোম</a>
    <span>/</span>
    <a href="/blog" class="hover:text-rb-600 transition">ব্লগ</a>
    <span>/</span>
    <a href="/blog?category=<%= encodeURIComponent(post.category) %>" class="hover:text-rb-600 transition"><%= post.category %></a>
    <span>/</span>
    <span class="text-gray-800 font-medium truncate max-w-xs"><%= post.title %></span>
  </nav>

  <!-- পোস্ট হেডার -->
  <header class="mb-8">
    <span class="inline-block px-3.5 py-1 rounded-full text-xs font-bold bg-rb-50 text-rb-600 border border-rb-100 mb-3">
      <%= post.category %>
    </span>
    <h1 class="font-head text-2xl sm:text-3xl md:text-4xl font-bold text-rb-900 leading-tight">
      <%= post.title %>
    </h1>

    <div class="flex flex-wrap items-center gap-4 text-xs sm:text-sm text-gray-500 mt-4 pb-6 border-b border-rb-100">
      <div class="flex items-center gap-2">
        <span class="w-8 h-8 rounded-full bg-rb-100 text-rb-600 flex items-center justify-center font-bold text-xs">
          <i class="fa-solid fa-user-doctor"></i>
        </span>
        <span class="font-semibold text-gray-800"><%= post.authorName || 'রক্তবার্তা মেডিকেল ডেস্ক' %></span>
      </div>
      <span>•</span>
      <span><i class="fa-regular fa-calendar mr-1"></i><%= formatBnDate(post.createdAt) %></span>
      <span>•</span>
      <span><i class="fa-regular fa-clock mr-1"></i><%= post.readTime %></span>
      <span>•</span>
      <span><i class="fa-regular fa-eye mr-1"></i><%= toBn(post.views || 1) %> বার পঠিত</span>
    </div>
  </header>

  <!-- কভার ছবি -->
  <% if (post.coverImage) { %>
    <div class="rounded-3xl overflow-hidden mb-8 shadow-sm max-h-[460px] bg-rb-50">
      <img src="<%= post.coverImage %>" alt="<%= post.title %>" class="w-full h-full object-cover" onerror="this.src='/images/blog1.jpg'">
    </div>
  <% } %>

  <!-- সূচিপত্র (Table of Contents - যদি নিবন্ধে হেডিংস থাকে) -->
  <% if (toc && toc.length > 0) { %>
    <div class="glass rounded-2xl p-5 mb-8 border border-rb-100 bg-white/80">
      <h3 class="font-head text-base font-bold text-rb-900 mb-3 flex items-center gap-2">
        <i class="fa-solid fa-list-ul text-rb-600"></i>এই নিবন্ধের সূচিপত্র
      </h3>
      <ul class="space-y-1.5 text-sm">
        <% toc.forEach(item => { %>
          <li class="<%= item.level === '3' ? 'ml-4' : '' %>">
            <a href="#<%= item.id %>" class="text-gray-700 hover:text-rb-600 transition flex items-center gap-1.5">
              <i class="fa-solid fa-angle-right text-[10px] text-rb-400"></i>
              <span><%= item.title %></span>
            </a>
          </li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <!-- মূল নিবন্ধ কন্টেন্ট (Stylized rich content) -->
  <div class="prose max-w-none text-gray-800 leading-relaxed text-base sm:text-lg space-y-5">
    <%- post.content %>
  </div>

  <!-- ট্যাগসমূহ -->
  <% if (post.tags && post.tags.length > 0) { %>
    <div class="flex flex-wrap items-center gap-2 mt-8 pt-6 border-t border-rb-100">
      <span class="text-xs font-semibold text-gray-500 mr-1"><i class="fa-solid fa-tags mr-1"></i>ট্যাগসমূহ:</span>
      <% post.tags.forEach(tag => { %>
        <a href="/blog?tag=<%= encodeURIComponent(tag) %>" class="px-3 py-1 rounded-xl text-xs font-medium glass hover:bg-rb-50 text-gray-700 transition">
          #<%= tag %>
        </a>
      <% }) %>
    </div>
  <% } %>

  <!-- সোশ্যাল শেয়ার বার -->
  <div class="glass rounded-2xl p-4 sm:p-5 mt-8 flex flex-wrap items-center justify-between gap-4 border border-rb-100">
    <div class="flex items-center gap-2 text-sm font-semibold text-gray-800">
      <i class="fa-solid fa-share-nodes text-rb-600 text-lg"></i>
      <span>নিবন্ধটি শেয়ার করুন:</span>
    </div>
    <div class="flex items-center gap-2">
      <!-- ফেসবুক -->
      <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(siteUrl + '/blog/' + post.slug) %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[#1877F2] text-white flex items-center justify-center hover:opacity-90 transition" aria-label="ফেসবুকে শেয়ার করুন">
        <i class="fa-brands fa-facebook-f text-sm"></i>
      </a>
      <!-- হোয়াটসঅ্যাপ -->
      <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(post.title + ' ' + siteUrl + '/blog/' + post.slug) %>" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-[#25D366] text-white flex items-center justify-center hover:opacity-90 transition" aria-label="হোয়াটসঅ্যাপে শেয়ার করুন">
        <i class="fa-brands fa-whatsapp text-sm"></i>
      </a>
      <!-- লিংক কপি -->
      <button onclick="copyToClipboard('<%= siteUrl %>/blog/<%= post.slug %>')" class="px-3.5 py-1.5 rounded-full glass hover:bg-rb-50 text-xs font-bold text-gray-700 flex items-center gap-1.5 transition">
        <i class="fa-solid fa-link text-rb-600"></i>লিংক কপি
      </button>
    </div>
  </div>

  <!-- লেখক বক্স -->
  <div class="glass rounded-3xl p-6 mt-8 border border-rb-100 flex items-start gap-4">
    <div class="w-14 h-14 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-2xl flex-shrink-0 shadow-inner">
      <i class="fa-solid fa-user-doctor"></i>
    </div>
    <div>
      <h4 class="font-head font-bold text-gray-900 text-base"><%= post.authorName || 'রক্তবার্তা মেডিকেল ও রিসার্চ ডেস্ক' %></h4>
      <p class="text-xs text-gray-500 mt-0.5">স্বাস্থ্য ও রক্তদান বিষয়ক বিশেষ টিম</p>
      <p class="text-xs text-gray-600 mt-2 leading-relaxed">
        আমাদের মেডিকেল ও ভলান্টিয়ার টিম নিয়মিত রক্তদান, পুষ্টি ও জনস্বাস্থ্য বিষয়ক বৈজ্ঞানিক গবেষণানির্ভর তথ্য প্রকাশ করে যাতে সাধারণ মানুষ সচেতন ও সুস্থ থাকতে পারে।
      </p>
    </div>
  </div>

  <!-- মন্তব্য সেকশন -->
  <section id="comments" class="mt-12 pt-8 border-t border-rb-100">
    <h3 class="font-head text-2xl font-bold text-rb-900 mb-6 flex items-center gap-2">
      <i class="fa-regular fa-comments text-rb-600"></i>
      <span>পাঠকদের মন্তব্য (<%= toBn(comments ? comments.length : 0) %>)</span>
    </h3>

    <!-- মন্তব্য জমা দেওয়ার ফর্ম -->
    <div id="commentForm" class="glass rounded-3xl p-6 mb-8 border border-rb-100">
      <% if (currentUser) { %>
        <form action="/blog/<%= post.slug %>/comment" method="POST" class="space-y-4">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">
              মন্তব্য লিখুন (<%= currentUser.name %> হিসেবে):
            </label>
            <textarea name="text" rows="3" required placeholder="আপনার মতামত বা জিজ্ঞাসা লিখুন..." class="w-full text-sm"></textarea>
          </div>
          <button type="submit" class="btn px-5 py-2 text-sm">
            <i class="fa-solid fa-paper-plane mr-1.5"></i>মন্তব্য প্রকাশ করুন
          </button>
        </form>
      <% } else { %>
        <div class="text-center py-4">
          <p class="text-sm text-gray-600">মন্তব্য করতে বা আলোচনায় অংশ নিতে অনুগ্রহ করে লগইন করুন।</p>
          <a href="/login?returnUrl=/blog/<%= post.slug %>" class="btn mt-3 inline-block px-5 py-2 text-xs">
            লগইন করুন
          </a>
        </div>
      <% } %>
    </div>

    <!-- মন্তব্য তালিকা -->
    <% if (comments && comments.length > 0) { %>
      <div class="space-y-4">
        <% comments.forEach(c => { %>
          <div class="glass rounded-2xl p-4 sm:p-5 border border-rb-50">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2.5">
                <span class="w-8 h-8 rounded-full bg-rb-100 text-rb-600 flex items-center justify-center font-bold text-xs">
                  <i class="fa-solid fa-user"></i>
                </span>
                <span class="font-semibold text-sm text-gray-800"><%= c.userName %></span>
              </div>
              <span class="text-xs text-gray-400">
                <i class="fa-regular fa-clock mr-1"></i><%= formatBnDate(c.createdAt) %>
              </span>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed pl-10">
              <%= c.text %>
            </p>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-center text-sm text-gray-500 py-4">এখনও কোনো মন্তব্য করা হয়নি। প্রথম মন্তব্যকারী আপনিই হোন!</p>
    <% } %>
  </section>

  <!-- সম্পর্কিত অন্যান্য নিবন্ধ -->
  <% if (relatedPosts && relatedPosts.length > 0) { %>
    <section class="mt-16 pt-8 border-t border-rb-100">
      <h3 class="font-head text-2xl font-bold text-rb-900 mb-6">সম্পর্কিত আরও নিবন্ধ</h3>
      <div class="grid sm:grid-cols-3 gap-6">
        <% relatedPosts.forEach(rel => { %>
          <a href="/blog/<%= rel.slug %>" class="glass rounded-3xl overflow-hidden card-hover flex flex-col border border-rb-50 group">
            <div class="h-36 overflow-hidden bg-rb-50">
              <% if (rel.coverImage) { %>
                <img src="<%= rel.coverImage %>" alt="<%= rel.title %>" class="w-full h-full object-cover group-hover:scale-105 transition" onerror="this.src='/images/blog1.jpg'">
              <% } else { %>
                <div class="w-full h-full flex items-center justify-center text-rb-300">
                  <i class="fa-solid fa-newspaper text-3xl"></i>
                </div>
              <% } %>
            </div>
            <div class="p-4 flex-1 flex flex-col justify-between">
              <h4 class="font-head text-sm font-bold text-gray-900 group-hover:text-rb-600 transition line-clamp-2 leading-snug">
                <%= rel.title %>
              </h4>
              <span class="text-xs text-gray-400 mt-2 block">
                <i class="fa-regular fa-calendar mr-1"></i><%= formatBnDate(rel.createdAt) %>
              </span>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
</article>

<script>
  function copyToClipboard(url) {
    navigator.clipboard.writeText(url).then(() => {
      alert('লিংকটি ক্লিপবোর্ডে কপি করা হয়েছে!');
    }).catch(() => {
      prompt('লিংক কপি করতে নিচের বক্সটি ব্যবহার করুন:', url);
    });
  }
</script>
