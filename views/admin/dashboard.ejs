<!-- অ্যাডমিন ড্যাশবোর্ড ওভারভিউ -->
<div class="space-y-8">
  <!-- মেটাক্রিক্স কার্ড গ্রিড (৭টি গুরুত্বপূর্ণ কাউন্টার) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-users"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">সর্বমোট ইউজার</p>
        <p class="text-2xl font-bold text-gray-900"><%= toBn(stats.totalUsers) %></p>
      </div>
    </div>

    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-rb-50 text-rb-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-heart-pulse"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">নিবন্ধিত রক্তদাতা</p>
        <p class="text-2xl font-bold text-rb-600"><%= toBn(stats.totalDonors) %></p>
      </div>
    </div>

    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-droplet"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">সক্রিয় রক্তের অনুরোধ</p>
        <p class="text-2xl font-bold text-amber-600"><%= toBn(stats.openRequests) %></p>
      </div>
    </div>

    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-clock-rotate-left"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">মোট অনুরোধ</p>
        <p class="text-2xl font-bold text-purple-600"><%= toBn(stats.totalRequests) %></p>
      </div>
    </div>

    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-feather-pointed"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">অপেক্ষমাণ গল্প</p>
        <p class="text-2xl font-bold text-orange-600"><%= toBn(stats.pendingStories) %></p>
      </div>
    </div>

    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-newspaper"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">ব্লগ পোস্ট</p>
        <p class="text-2xl font-bold text-emerald-600"><%= toBn(stats.totalPosts) %></p>
      </div>
    </div>

    <div class="glass rounded-3xl p-5 border border-rb-50 flex items-center gap-4">
      <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl flex-shrink-0">
        <i class="fa-solid fa-envelope-open-text"></i>
      </div>
      <div>
        <p class="text-xs text-gray-500 font-medium">নতুন বার্তা</p>
        <p class="text-2xl font-bold text-rose-600"><%= toBn(stats.newContacts) %></p>
      </div>
    </div>
  </div>

  <!-- দ্রুত অ্যাকশন বোতামসমূহ -->
  <div class="glass rounded-3xl p-6 border border-rb-100 flex flex-wrap items-center justify-between gap-4">
    <div>
      <h3 class="font-head text-base font-bold text-gray-900">দ্রুত অ্যাকশন প্যানেল</h3>
      <p class="text-xs text-gray-500">জরুরি কাজগুলো সহজে এক ক্লিকে সম্পন্ন করুন</p>
    </div>
    <div class="flex flex-wrap gap-2.5">
      <a href="/admin/posts/new" class="btn px-4 py-2 text-xs">
        <i class="fa-solid fa-plus mr-1"></i>নতুন ব্লগ পোস্ট (SEO)
      </a>
      <a href="/admin/stories?status=pending" class="glass px-4 py-2 rounded-xl text-xs font-semibold hover:border-rb-500 text-gray-800 transition">
        <i class="fa-solid fa-check-double text-orange-600 mr-1"></i>গল্প অনুমোদন করুন
      </a>
      <a href="/admin/export/donors" class="glass px-4 py-2 rounded-xl text-xs font-semibold hover:border-green-600 text-green-700 transition">
        <i class="fa-solid fa-download mr-1"></i>রক্তদাতা CSV
      </a>
    </div>
  </div>

  <!-- সাম্প্রতিক কার্যকলাপের দুটি টেবিল (অনুরোধ ও ইউজার) -->
  <div class="grid lg:grid-cols-2 gap-8">
    <!-- সাম্প্রতিক রক্তের অনুরোধসমূহ -->
    <div class="glass rounded-3xl p-6 border border-rb-100 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-rb-100">
          <h3 class="font-head text-base font-bold text-rb-900 flex items-center gap-2">
            <i class="fa-solid fa-hand-holding-droplet text-rb-600"></i>সাম্প্রতিক রক্তের অনুরোধ
          </h3>
          <a href="/admin/requests" class="text-xs text-rb-600 font-bold hover:underline">সকল অনুরোধ</a>
        </div>

        <% if (recentRequests && recentRequests.length > 0) { %>
          <div class="space-y-3">
            <% recentRequests.forEach(r => { %>
              <div class="p-3 rounded-2xl bg-white/70 border border-rb-50 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-xl bg-rb-50 text-rb-600 font-bold text-sm flex items-center justify-center border border-rb-100">
                    <%= toBnGroup(r.bloodGroup) %>
                  </span>
                  <div>
                    <h4 class="text-xs font-bold text-gray-900"><%= r.patientName %> (<%= r.hospitalName %>)</h4>
                    <p class="text-[11px] text-gray-500"><%= r.district %>, <%= r.upazila %> • <%= r.urgency %></p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold <%= r.status === 'open' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-gray-100 text-gray-600' %>">
                    <%= r.status %>
                  </span>
                  <p class="text-[10px] text-gray-400 mt-0.5"><%= formatBnDate(r.createdAt) %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-500 py-6 text-center">কোনো অনুরোধ পাওয়া যায়নি</p>
        <% } %>
      </div>
    </div>

    <!-- সাম্প্রতিক নিবন্ধিত ব্যবহারকারী -->
    <div class="glass rounded-3xl p-6 border border-rb-100 flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-rb-100">
          <h3 class="font-head text-base font-bold text-rb-900 flex items-center gap-2">
            <i class="fa-solid fa-user-plus text-blue-600"></i>নতুন নিবন্ধিত সদস্য
          </h3>
          <a href="/admin/users" class="text-xs text-rb-600 font-bold hover:underline">সকল সদস্য</a>
        </div>

        <% if (recentUsers && recentUsers.length > 0) { %>
          <div class="space-y-3">
            <% recentUsers.forEach(u => { %>
              <div class="p-3 rounded-2xl bg-white/70 border border-rb-50 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                  <span class="w-10 h-10 rounded-full bg-blue-50 text-blue-600 font-bold text-sm flex items-center justify-center">
                    <%= u.name.charAt(0) %>
                  </span>
                  <div>
                    <h4 class="text-xs font-bold text-gray-900"><%= u.name %></h4>
                    <p class="text-[11px] text-gray-500"><%= u.phone %> • <%= u.district %></p>
                  </div>
                </div>
                <div class="text-right">
                  <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold <%= u.isDonor ? 'bg-rb-50 text-rb-700' : 'bg-gray-100 text-gray-600' %>">
                    <%= u.isDonor ? 'রক্তদাতা' : 'ইউজার' %>
                  </span>
                  <p class="text-[10px] text-gray-400 mt-0.5"><%= toBnGroup(u.bloodGroup) %></p>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-gray-500 py-6 text-center">কোনো ব্যবহারকারী নেই</p>
        <% } %>
      </div>
    </div>
  </div>
</div>
